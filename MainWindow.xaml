<Window x:Class="RevitJournalViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="The Revit Matrix" Height="760" Width="1150" MinWidth="760" MinHeight="420"
        Icon="Assets/TheRevitMatrix.ico"
        FontFamily="Segoe UI" FontSize="12"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Fg}"
        BorderBrush="{DynamicResource Border}" BorderThickness="1"
        StateChanged="Window_StateChanged"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <!-- PyPiPie custom title bar: the app draws its own caption, following the theme -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- F1 = Help -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Help" Executed="Help_Executed"/>
    </Window.CommandBindings>

    <Window.Resources>
        <!-- ===== Title bar caption buttons (PyPiPie) ===== -->
        <Style x:Key="Caption" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Caption}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Credit link in the status bar -->
        <Style x:Key="CreditLinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource StatusFg}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Plain push buttons -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonFg}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pause toggle -->
        <Style TargetType="ToggleButton">
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonFg}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category filter chips: checked = shown -->
        <Style x:Key="ChipToggle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,2,6,2"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="{DynamicResource ChipBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChipBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource InputFg}"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        </Style>

        <!-- ===================== Scroll bars (output view, dropdown list) ===================== -->
        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" CornerRadius="4" Background="{DynamicResource ScrollThumb}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollPageStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageUpCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollThumbStyle}" Margin="2,2"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageDownCommand"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageLeftCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollThumbStyle}" Margin="2,2"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageRightCommand"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ScrollTrack}"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="MinHeight" Value="12"/>
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===================== Session dropdown ===================== -->
        <Style x:Key="ComboToggleStyle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{DynamicResource InputBg}"
                                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="3">
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                                  Data="M 0 0 L 4 4 L 8 0" StrokeThickness="1.5"
                                  Stroke="{DynamicResource MutedFg}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource InputFg}"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource ComboToggleStyle}" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter IsHitTestVisible="False" Margin="7,3,26,3"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                                   AllowsTransparency="True" PopupAnimation="Slide"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource PanelBg}"
                                        BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource InputFg}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel x:Name="RootPanel">
        <!-- ================= Title bar ================= -->
        <Border DockPanel.Dock="Top" Height="34" Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image Source="Assets/TheRevitMatrix.png" Width="20" Height="20" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="The Revit Matrix" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TitleInfo" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="190,0,190,0"
                           FontStyle="Italic" FontSize="13" Foreground="{DynamicResource MutedFg}"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Caption}" Content="&#xE897;" ToolTip="Help (F1)" Click="CapHelp_Click"/>
                    <Button Style="{StaticResource Caption}" Content="&#xE921;" ToolTip="Minimize" Click="CapMin_Click"/>
                    <Button x:Name="CapMax" Style="{StaticResource Caption}" Content="&#xE922;" ToolTip="Maximize" Click="CapMax_Click"/>
                    <Button Style="{StaticResource CaptionClose}" Content="&#xE8BB;" ToolTip="Close" Click="CapClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Session picker -->
        <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
            <TextBlock Text="Revit session:" Margin="0,0,6,0"/>
            <Button x:Name="ThemeButton" DockPanel.Dock="Right" Content="Theme: Auto" Click="ThemeButton_Click"
                    ToolTip="Auto follows the Windows theme (as Revit does when it follows the system theme). Click to cycle Auto / Dark / Light."/>
            <Button DockPanel.Dock="Right" Content="Open journal file…" Click="Browse_Click"/>
            <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click"/>
            <ComboBox x:Name="SessionCombo" SelectionChanged="SessionCombo_SelectionChanged"/>
        </DockPanel>

        <!-- Toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="8,0,8,4">
            <TextBlock Text="Filter:" Margin="0,0,6,0"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox x:Name="LoadExistingCheck" Content="Load existing (last 2 MB)" IsChecked="True"
                          ToolTip="Show recent journal content when attaching, not just new lines"/>
                <CheckBox x:Name="LineNumbersCheck" Content="Line #" IsChecked="True"
                          ToolTip="Show the line number in the journal file"
                          Checked="LineInfoCheck_Changed" Unchecked="LineInfoCheck_Changed"/>
                <CheckBox x:Name="TimestampsCheck" Content="Time" IsChecked="True"
                          ToolTip="Show each line's time (HH:mm:ss::hundredths). Bright = the line's own timestamp; dim = carried from the last timestamped line"
                          Checked="LineInfoCheck_Changed" Unchecked="LineInfoCheck_Changed"/>
                <CheckBox x:Name="ColorsCheck" Content="Colors" IsChecked="True"
                          Checked="ColorsCheck_Changed" Unchecked="ColorsCheck_Changed"/>
                <CheckBox x:Name="AutoScrollCheck" Content="Auto-scroll" IsChecked="True"/>
                <ToggleButton x:Name="PauseToggle" Content="Pause"
                              Checked="PauseToggle_Changed" Unchecked="PauseToggle_Changed"/>
                <Button Content="Clear" Click="Clear_Click"/>
                <Button Content="Save…" Click="Save_Click"/>
            </StackPanel>
            <TextBox x:Name="FilterBox" MinWidth="150"
                     ToolTip="Show only lines containing this text (case-insensitive)"
                     TextChanged="FilterChanged"/>
        </DockPanel>

        <!-- Category filter -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBg}" Padding="8,4">
            <DockPanel>
                <TextBlock Text="Show:" Margin="0,0,8,0" Foreground="{DynamicResource MutedFg}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="All" Click="ShowAll_Click" ToolTip="Show every category"/>
                    <Button Content="Problems" Click="ShowProblems_Click"
                            ToolTip="Show only errors and warnings"/>
                    <Button Content="Activity" Click="ShowActivity_Click"
                            ToolTip="Commands, actions, events and problems; hides add-in and memory noise"/>
                </StackPanel>
                <WrapPanel x:Name="CategoryPanel"
                           ToolTip="Click to show/hide a category. Right-click to show only that category."/>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <!-- Background is animated from code to show state: idle / live / activity / warning / error / paused / ended -->
        <!-- PyPiPie status bar: credit | hint/status ........ state | version -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Padding="10,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Foreground="{DynamicResource StatusFg}" Opacity="0.85" Margin="0,0,10,0">
                    <Run Text="Crafted by: "/><Hyperlink NavigateUri="https://www.linkedin.com/in/aaronrumple/"
                        RequestNavigate="Link_RequestNavigate" ToolTip="Aaron Rumple on LinkedIn"
                        Style="{StaticResource CreditLinkStyle}" FontWeight="SemiBold">Aaron Rumple, AIA</Hyperlink>
                </TextBlock>
                <Border DockPanel.Dock="Left" Width="1" Margin="0,2,10,2" Background="{DynamicResource StatusFg}" Opacity="0.4"/>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Margin="10,0,0,0"
                           Foreground="{DynamicResource StatusFg}" Opacity="0.85"/>
                <Border DockPanel.Dock="Right" Width="1" Margin="10,2,0,2" Background="{DynamicResource StatusFg}" Opacity="0.4"/>
                <TextBlock x:Name="StatusState" DockPanel.Dock="Right" Margin="12,0,0,0"
                           Foreground="{DynamicResource StatusFg}" FontWeight="SemiBold" Text="IDLE"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource StatusFg}" TextTrimming="CharacterEllipsis"
                           Text="Click a category to show or hide it; right-click to show only that one. F1 for help."/>
            </DockPanel>
        </Border>

        <!-- Output window -->
        <avalonEdit:TextEditor x:Name="Output"
                 IsReadOnly="True"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 Background="{DynamicResource OutputBg}" Foreground="{DynamicResource OutputFg}"
                 BorderThickness="0" Padding="6" WordWrap="False" ShowLineNumbers="False"
                 VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
