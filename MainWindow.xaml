<Window x:Class="RevitJournalViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:RevitJournalViewer"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="The Revit Matrix" Height="760" Width="1150" MinWidth="760" MinHeight="420"
        Icon="Assets/TheRevitMatrix.ico"
        FontFamily="Segoe UI" FontSize="12"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Fg}"
        BorderBrush="{DynamicResource Border}" BorderThickness="1"
        StateChanged="Window_StateChanged" PreviewKeyDown="Window_PreviewKeyDown" ContextMenuOpening="Window_ContextMenuOpening"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <!-- PyPiPie custom title bar: the app draws its own caption, following the theme -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- F1 = Help -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Help" Executed="Help_Executed"/>
    </Window.CommandBindings>

    <Window.Resources>
        <!-- ===== Title bar caption buttons (PyPiPie) ===== -->
        <Style x:Key="Caption" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Caption}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Credit link in the status bar -->
        <Style x:Key="CreditLinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource StatusFg}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Plain push buttons -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonFg}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pause toggle -->
        <Style TargetType="ToggleButton">
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonFg}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category filter chips: checked = shown -->
        <Style x:Key="ChipToggle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,2,6,2"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="{DynamicResource ChipBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChipBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource InputFg}"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>

        <!-- Help balloons: every tooltip in the app -->
        <Style TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource ButtonBg}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,8,8" MaxWidth="300">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter TextElement.Foreground="{DynamicResource Fg}">
                                <ContentPresenter.Resources>
                                    <DataTemplate DataType="{x:Type sys:String}">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Lists in the bottom flyout ===== -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="0,2">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource MutedFg}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border x:Name="Bd" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="0,0,1,1" Padding="6,3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Session tabs -->
        <Style x:Key="SessionTabStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="{DynamicResource ChipBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChipBorder}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="9,3,4,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- × inside a text box that clears it -->
        <Style x:Key="ClearButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedFg}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Content" Value="&#xE711;"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCloseStyle" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedFg}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Content" Value="&#xE8BB;"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window-length buttons in the timeline header -->
        <Style x:Key="Seg" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedFg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== Scroll bars (output view, dropdown list) ===================== -->
        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" CornerRadius="4" Background="{DynamicResource ScrollThumb}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollPageStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageUpCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollThumbStyle}" Margin="2,2"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageDownCommand"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageLeftCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollThumbStyle}" Margin="2,2"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageRightCommand"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ScrollTrack}"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="MinHeight" Value="12"/>
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===================== Session dropdown ===================== -->
        <Style x:Key="ComboToggleStyle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{DynamicResource InputBg}"
                                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="3">
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                                  Data="M 0 0 L 4 4 L 8 0" StrokeThickness="1.5"
                                  Stroke="{DynamicResource MutedFg}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource InputFg}"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource ComboToggleStyle}" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter IsHitTestVisible="False" Margin="7,3,26,3"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                                   AllowsTransparency="True" PopupAnimation="Slide"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource PanelBg}"
                                        BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource InputFg}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Right-click menu (themed) -->
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="0,4" Margin="0,0,6,6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="0,4" Margin="4,0" CornerRadius="3" MinWidth="230">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Accent}" Visibility="Hidden"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,10,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource MutedFg}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,4" Background="{DynamicResource Border}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="MainMenu" Opened="MainMenu_Opened">
            <MenuItem x:Name="MenuTimeline" Header="Timeline" InputGestureText="F3" Tag="timeline" Click="MenuFlyoutTab_Click"/>
            <MenuItem x:Name="MenuSlow" Header="Slow operations" Tag="slow" Click="MenuFlyoutTab_Click"/>
            <MenuItem x:Name="MenuAddins" Header="Add-in startup" Tag="addins" Click="MenuFlyoutTab_Click"/>
            <MenuItem x:Name="MenuSummary" Header="Session summary" Tag="summary" Click="MenuFlyoutTab_Click"/>
            <MenuItem x:Name="MenuFolders" Header="Journal folders" Tag="folders" Click="MenuFlyoutTab_Click"/>
            <Separator/>
            <MenuItem x:Name="MenuPerf" Header="Revit performance" InputGestureText="F2" Click="MenuPerf_Click"/>
            <Separator/>
            <MenuItem x:Name="MenuStart" Header="Start" InputGestureText="Home, Ctrl+Home" Click="MenuStart_Click"
                      ToolTip="Go to the first line of the log"/>
            <MenuItem x:Name="MenuCurrent" Header="Current" InputGestureText="End, Ctrl+End" Click="MenuCurrent_Click"
                      ToolTip="Go to the latest line; auto-scroll follows new lines again"/>
            <Separator x:Name="MenuLogSeparator"/>
            <MenuItem x:Name="MenuBookmark" Header="Bookmark this line" InputGestureText="Ctrl+B" Click="MenuBookmark_Click"/>
            <MenuItem x:Name="MenuCopy" Header="Copy" InputGestureText="Ctrl+C" Click="MenuCopy_Click"/>
            <MenuItem x:Name="MenuSelectAll" Header="Select all" InputGestureText="Ctrl+A" Click="MenuSelectAll_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <DockPanel x:Name="RootPanel">
        <!-- ================= Title bar ================= -->
        <Border DockPanel.Dock="Top" Height="34" Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image Source="Assets/TheRevitMatrix.png" Width="20" Height="20" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="The Revit Matrix" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TitleInfo" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="190,0,190,0"
                           FontStyle="Italic" FontSize="13" Foreground="{DynamicResource MutedFg}"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CapTimeline" Style="{StaticResource Caption}" Click="TimelineToggle_Click"
                            ToolTipService.Placement="Bottom" ToolTipService.InitialShowDelay="300">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Data="M1.5,4 H14.5 M1.5,8 H14.5 M1.5,12 H14.5" StrokeThickness="1.3" Opacity="0.45"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Path Data="M2.6,4 a1.4,1.4 0 1 0 2.8,0 a1.4,1.4 0 1 0 -2.8,0 M8.6,8 a1.4,1.4 0 1 0 2.8,0 a1.4,1.4 0 1 0 -2.8,0 M5.1,12 a1.4,1.4 0 1 0 2.8,0 a1.4,1.4 0 1 0 -2.8,0 M11.1,4 a1.4,1.4 0 1 0 2.8,0 a1.4,1.4 0 1 0 -2.8,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Canvas>
                        </Viewbox>
                        <Button.ToolTip>
                            <StackPanel>
                                <TextBlock Text="Timeline" FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap" Text="Every journal entry plotted by time. Click a dot to jump to its line.  (F3)"/>
                            </StackPanel>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="CapPerf" Style="{StaticResource Caption}" Content="&#xE9D9;" Click="PerfToggle_Click"
                            ToolTipService.Placement="Bottom" ToolTipService.InitialShowDelay="300">
                        <Button.ToolTip>
                            <StackPanel>
                                <TextBlock Text="Revit performance" FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap" Text="Live graphs of Revit's CPU, memory and GPU use.  (F2)"/>
                            </StackPanel>
                        </Button.ToolTip>
                    </Button>
                    <Button Style="{StaticResource Caption}" Content="&#xE897;" Click="CapHelp_Click"
                            ToolTipService.Placement="Bottom" ToolTipService.InitialShowDelay="300">
                        <Button.ToolTip>
                            <StackPanel>
                                <TextBlock Text="Help" FontWeight="SemiBold"/>
                                <TextBlock Text="Open the user guide.  (F1)"/>
                            </StackPanel>
                        </Button.ToolTip>
                    </Button>
                    <Button Style="{StaticResource Caption}" Content="&#xE921;" ToolTip="Minimize" Click="CapMin_Click"/>
                    <Button x:Name="CapMax" Style="{StaticResource Caption}" Content="&#xE922;" ToolTip="Maximize" Click="CapMax_Click"/>
                    <Button Style="{StaticResource CaptionClose}" Content="&#xE8BB;" ToolTip="Close" Click="CapClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Session tabs: one per running Revit session, plus journals opened from a file -->
        <DockPanel DockPanel.Dock="Top" Margin="8,6,8,4">
            <Button x:Name="ThemeButton" DockPanel.Dock="Right" Content="Theme: Auto" Click="ThemeButton_Click"
                    ToolTip="Auto follows the Windows theme (as Revit does when it follows the system theme). Click to cycle Auto / Dark / Light."/>
            <Button DockPanel.Dock="Right" Content="Open journal file…" Click="Browse_Click"
                    ToolTip="Open any journal, such as one from an earlier session, in a new tab"/>
            <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click"
                    ToolTip="Look for Revit sessions now, and bring back any session tab you closed"/>
            <TextBlock x:Name="NoSessionsText" DockPanel.Dock="Left" Foreground="{DynamicResource MutedFg}" Margin="2,0,0,0"
                       Text="No running Revit found yet. Sessions appear here as tabs when Revit starts."/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="SessionTabs" Orientation="Horizontal"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="8,0,8,4">
            <TextBlock Text="Filter:" Margin="0,0,6,0"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox x:Name="LoadExistingCheck" Content="Load existing (last 2 MB)" IsChecked="True"
                          ToolTip="Show recent journal content when attaching, not just new lines"/>
                <CheckBox x:Name="LineNumbersCheck" Content="Line #" IsChecked="True"
                          ToolTip="Show the line number in the journal file"
                          Checked="LineInfoCheck_Changed" Unchecked="LineInfoCheck_Changed"/>
                <CheckBox x:Name="TimestampsCheck" Content="Time" IsChecked="True"
                          ToolTip="Show each line's time (HH:mm:ss::hundredths). Bright = the line's own timestamp; dim = carried from the last timestamped line"
                          Checked="LineInfoCheck_Changed" Unchecked="LineInfoCheck_Changed"/>
                <CheckBox x:Name="ColorsCheck" Content="Colors" IsChecked="True"
                          Checked="ColorsCheck_Changed" Unchecked="ColorsCheck_Changed"/>
                <CheckBox x:Name="AutoScrollCheck" Content="Auto-scroll" IsChecked="True"/>
                <CheckBox x:Name="NotifyCheck" Content="Notify" IsChecked="True"
                          Checked="NotifyCheck_Changed" Unchecked="NotifyCheck_Changed"
                          ToolTip="While this window is in the background, show a Windows notification when Revit logs an error or finishes a long open, save or sync"/>
                <ToggleButton x:Name="PauseToggle" Content="Pause"
                              Checked="PauseToggle_Changed" Unchecked="PauseToggle_Changed"/>
                <Button Content="Clear" Click="Clear_Click"/>
                <Button Content="Save…" Click="Save_Click"/>
            </StackPanel>
            <Grid MinWidth="150">
                <TextBox x:Name="FilterBox" Padding="3,2,24,2"
                         ToolTip="Show only lines containing this text (case-insensitive). Esc clears it."
                         TextChanged="FilterChanged" PreviewKeyDown="FilterBox_PreviewKeyDown"/>
                <Button x:Name="FilterClear" Style="{StaticResource ClearButtonStyle}" HorizontalAlignment="Right"
                        Margin="0,0,3,0" Visibility="Collapsed" Click="FilterClear_Click" ToolTip="Clear the filter (Esc)"/>
            </Grid>
        </DockPanel>

        <!-- Category filter -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBg}" Padding="8,4">
            <DockPanel>
                <TextBlock Text="Show:" Margin="0,0,8,0" Foreground="{DynamicResource MutedFg}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="All" Click="ShowAll_Click" ToolTip="Show every category"/>
                    <Button Content="Problems" Click="ShowProblems_Click"
                            ToolTip="Show only errors and warnings"/>
                    <Button Content="Activity" Click="ShowActivity_Click"
                            ToolTip="Commands, actions, events and problems; hides add-in and memory noise"/>
                </StackPanel>
                <WrapPanel x:Name="CategoryPanel"
                           ToolTip="Click to show/hide a category. Right-click to show only that category."/>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <!-- Background is animated from code to show state: idle / live / activity / warning / error / paused / ended -->
        <!-- PyPiPie status bar: credit | hint/status ........ state | version -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Padding="10,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Foreground="{DynamicResource StatusFg}" Opacity="0.85" Margin="0,0,10,0">
                    <Run Text="Crafted by: "/><Hyperlink NavigateUri="https://www.linkedin.com/in/aaronrumple/"
                        RequestNavigate="Link_RequestNavigate" ToolTip="Aaron Rumple on LinkedIn"
                        Style="{StaticResource CreditLinkStyle}" FontWeight="SemiBold">Aaron Rumple, AIA</Hyperlink>
                </TextBlock>
                <Border DockPanel.Dock="Left" Width="1" Margin="0,2,10,2" Background="{DynamicResource StatusFg}" Opacity="0.4"/>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Margin="10,0,0,0"
                           Foreground="{DynamicResource StatusFg}" Opacity="0.85"/>
                <Border DockPanel.Dock="Right" Width="1" Margin="10,2,0,2" Background="{DynamicResource StatusFg}" Opacity="0.4"/>
                <TextBlock x:Name="StatusState" DockPanel.Dock="Right" Margin="12,0,0,0"
                           Foreground="{DynamicResource StatusFg}" FontWeight="SemiBold" Text="IDLE"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource StatusFg}" TextTrimming="CharacterEllipsis"
                           Text="Click a category to show or hide it; right-click to show only that one. F1 for help."/>
            </DockPanel>
        </Border>

        <!-- ================= Performance flyout (right, full height): docked before the bottom flyout so it is never covered ================= -->
        <!-- Width is animated between 0 and 321 from code; the content keeps a fixed width so it doesn't reflow. -->
        <Border x:Name="PerfPanel" DockPanel.Dock="Right" Width="0" ClipToBounds="True"
                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
            <DockPanel Width="320" HorizontalAlignment="Left">
                <DockPanel DockPanel.Dock="Top" Margin="14,10,6,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Caption}" Width="30" Height="26"
                            Content="&#xE8BB;" ToolTip="Close (F2)" Click="PerfToggle_Click" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock Text="Revit performance" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Fg}"/>
                        <TextBlock x:Name="PerfTarget" Foreground="{DynamicResource MutedFg}" TextTrimming="CharacterEllipsis"
                                   Text="Not watching a running Revit session."/>
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="PerfFooter" DockPanel.Dock="Bottom" Margin="14,4,14,10" TextWrapping="Wrap"
                           FontSize="11" Foreground="{DynamicResource MutedFg}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PerfCharts" Margin="14,4,14,4"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= Bottom flyout (under the log, beside the side flyout): Timeline, Slow operations, Add-in startup, Summary, Journal folders ================= -->
        <!-- Height is animated between 0 and 301 from code; the content keeps a fixed height. -->
        <Border x:Name="TimelinePanel" DockPanel.Dock="Bottom" Height="0" ClipToBounds="True"
                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <DockPanel Height="300" VerticalAlignment="Top" Margin="10,8,10,10">
                <!-- header: tabs on the left, the open tab's controls on the right -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Caption}" Width="30" Height="26" Margin="6,0,0,0"
                            Content="&#xE8BB;" Click="TimelineToggle_Click" ToolTip="Close this panel  (F3)"/>
                    <StackPanel x:Name="TimelineControls" DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="Window" Foreground="{DynamicResource MutedFg}" Margin="0,0,6,0"/>
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                            <StackPanel x:Name="WindowButtons" Orientation="Horizontal">
                                <ToggleButton Style="{StaticResource Seg}" Content="1 min" Tag="60" Click="WindowButton_Click" ToolTip="Show the last minute"/>
                                <ToggleButton Style="{StaticResource Seg}" Content="5 min" Tag="300" Click="WindowButton_Click" ToolTip="Show the last 5 minutes"/>
                                <ToggleButton Style="{StaticResource Seg}" Content="15 min" Tag="900" Click="WindowButton_Click" ToolTip="Show the last 15 minutes"/>
                                <ToggleButton Style="{StaticResource Seg}" Content="All" Tag="0" Click="WindowButton_Click" ToolTip="Show the whole journal"/>
                            </StackPanel>
                        </Border>
                        <CheckBox x:Name="FollowCheck" Content="Follow live" IsChecked="True"
                                  Checked="FollowCheck_Changed" Unchecked="FollowCheck_Changed"
                                  ToolTip="Keep the newest entries in view as Revit writes them"/>
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="3" ClipToBounds="True"
                            HorizontalAlignment="Left">
                        <StackPanel x:Name="FlyoutTabs" Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource Seg}" Content="Timeline" Tag="timeline" Click="FlyoutTab_Click"
                                          ToolTip="Every journal entry plotted by time. Click a dot to jump to its line."/>
                            <ToggleButton Style="{StaticResource Seg}" Content="Slow operations" Tag="slow" Click="FlyoutTab_Click"
                                          ToolTip="Every operation Revit timed (opens, saves, syncs, regenerations, views…), with how long it took. Click a column to sort."/>
                            <ToggleButton Style="{StaticResource Seg}" Content="Add-in startup" Tag="addins" Click="FlyoutTab_Click"
                                          ToolTip="Which add-ins slowed Revit's startup, slowest first"/>
                            <ToggleButton Style="{StaticResource Seg}" Content="Summary" Tag="summary" Click="FlyoutTab_Click"
                                          ToolTip="Files, saves, syncs, commands, problems and memory for this session. Copy it into a support ticket."/>
                            <ToggleButton Style="{StaticResource Seg}" Content="Journal folders" Tag="folders" Click="FlyoutTab_Click"
                                          ToolTip="How much space Revit's journals take, and clean out old ones"/>
                        </StackPanel>
                    </Border>
                </DockPanel>

                <Grid>
                    <!-- Timeline -->
                    <DockPanel x:Name="TabTimeline">
                        <DockPanel DockPanel.Dock="Bottom" Margin="22,6,0,0">
                            <local:RangeBar x:Name="TimelineRange" DockPanel.Dock="Right" Width="300"
                                            ToolTip="Drag a handle to zoom, or drag between the handles to move through the journal"/>
                            <TextBlock x:Name="TimelineRangeText" DockPanel.Dock="Right" Margin="8,0,12,0"/>
                            <TextBlock DockPanel.Dock="Right" Text="Time range" Foreground="{DynamicResource MutedFg}"/>
                            <TextBlock x:Name="TimelineSummary" Foreground="{DynamicResource MutedFg}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <local:TimelineView x:Name="TimelinePlot"/>
                    </DockPanel>

                    <!-- Slow operations -->
                    <DockPanel x:Name="TabSlow" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <CheckBox x:Name="NestedCheck" DockPanel.Dock="Right" Content="Include nested steps" Margin="10,0,0,0"
                                      Checked="NestedCheck_Changed" Unchecked="NestedCheck_Changed"
                                      ToolTip="Also list the steps inside each operation (e.g. the loading stages of an open)"/>
                            <TextBlock x:Name="SlowInfo" Foreground="{DynamicResource MutedFg}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <ListView x:Name="SlowList" SelectionMode="Single" SelectionChanged="SlowList_SelectionChanged"
                                  GridViewColumnHeader.Click="List_HeaderClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Started" Width="76" DisplayMemberBinding="{Binding TimeText}"/>
                                    <GridViewColumn Header="Seconds" Width="74" DisplayMemberBinding="{Binding SecondsText}"/>
                                    <GridViewColumn Header="Kind" Width="96" DisplayMemberBinding="{Binding Kind}"/>
                                    <GridViewColumn Header="Level" Width="54" DisplayMemberBinding="{Binding DepthText}"/>
                                    <GridViewColumn Header="Operation" Width="360" DisplayMemberBinding="{Binding NameText}"/>
                                    <GridViewColumn Header="File" Width="420" DisplayMemberBinding="{Binding Detail}"/>
                                    <GridViewColumn Header="Line" Width="70" DisplayMemberBinding="{Binding LineText}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>

                    <!-- Add-in startup -->
                    <DockPanel x:Name="TabAddins" Visibility="Collapsed">
                        <TextBlock x:Name="AddinInfo" DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedFg}"/>
                        <ListView x:Name="AddinList" SelectionMode="Single" SelectionChanged="AddinList_SelectionChanged"
                                  GridViewColumnHeader.Click="List_HeaderClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Seconds" Width="74" DisplayMemberBinding="{Binding SecondsText}"/>
                                    <GridViewColumn Header="Memory added" Width="110" DisplayMemberBinding="{Binding RamText}"/>
                                    <GridViewColumn Header="Add-ins" Width="860" DisplayMemberBinding="{Binding NamesText}"/>
                                    <GridViewColumn Header="Line" Width="70" DisplayMemberBinding="{Binding LineText}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>

                    <!-- Summary -->
                    <DockPanel x:Name="TabSummary" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Copy" Margin="0" Click="SummaryCopy_Click" ToolTip="Copy the summary to the clipboard"/>
                            <Button Content="Save…" Click="SummarySave_Click" ToolTip="Save the summary as a text file"/>
                            <Button Content="Refresh" Click="SummaryRefresh_Click" ToolTip="Update the summary with the newest journal lines"/>
                            <TextBlock Margin="12,0,0,0" Foreground="{DynamicResource MutedFg}"
                                       Text="Plain text, ready to paste into a support ticket."/>
                        </StackPanel>
                        <TextBox x:Name="SummaryBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                    </DockPanel>

                    <!-- Journal folders -->
                    <DockPanel x:Name="TabFolders" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Journals older than"/>
                            <TextBox x:Name="DaysBox" Width="44" Margin="6,0" Text="30" TextAlignment="Right"
                                     TextChanged="DaysBox_TextChanged" ToolTip="Age in days, by the date each journal was last written"/>
                            <TextBlock Text="days:"/>
                            <TextBlock x:Name="FoldersOldText" Margin="6,0,10,0" FontWeight="SemiBold"/>
                            <Button x:Name="RecycleButton" Content="Move old to Recycle Bin" Margin="0" Click="Recycle_Click"
                                    ToolTip="Move every journal older than this to the Recycle Bin. Journals a running Revit or a tab here has open are kept."/>
                            <Button Content="Refresh" Click="FoldersRefresh_Click"/>
                            <TextBlock x:Name="FoldersTotal" Margin="12,0,0,0" Foreground="{DynamicResource MutedFg}"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="FoldersColumn" Width="2*" MinWidth="160"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition x:Name="FilesColumn" Width="3*" MinWidth="240"/>
                            </Grid.ColumnDefinitions>

                            <!-- Drag to resize the two lists -->
                            <GridSplitter x:Name="FoldersSplitter" Grid.Column="1" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE" Focusable="False"
                                          DragCompleted="FoldersSplitter_DragCompleted" MouseDoubleClick="FoldersSplitter_DoubleClick"
                                          ToolTip="Drag to resize the lists. Double-click to reset.">
                                <GridSplitter.Template>
                                    <ControlTemplate TargetType="GridSplitter">
                                        <Border x:Name="Hit" Background="Transparent">
                                            <Border x:Name="Line" Width="1" HorizontalAlignment="Center" Background="{DynamicResource Border}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Line" Property="Width" Value="3"/>
                                                <Setter TargetName="Line" Property="Background" Value="{DynamicResource Accent}"/>
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter TargetName="Line" Property="Width" Value="3"/>
                                                <Setter TargetName="Line" Property="Background" Value="{DynamicResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </GridSplitter.Template>
                            </GridSplitter>

                            <!-- Folders, one per Revit version -->
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Foreground="{DynamicResource MutedFg}" TextTrimming="CharacterEllipsis"
                                           Text="Select folders to list their journals. Double-click to open in File Explorer."/>
                                <ListView x:Name="FolderList" SelectionMode="Extended" MouseDoubleClick="FolderList_DoubleClick"
                                          SelectionChanged="FolderList_SelectionChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Revit" Width="110" DisplayMemberBinding="{Binding Version}"/>
                                            <GridViewColumn Header="Journals" Width="66" DisplayMemberBinding="{Binding FilesText}"/>
                                            <GridViewColumn Header="Size" Width="70" DisplayMemberBinding="{Binding SizeText}"/>
                                            <GridViewColumn Header="Oldest" Width="84" DisplayMemberBinding="{Binding OldestText}"/>
                                            <GridViewColumn Header="Old enough to clear" Width="130" DisplayMemberBinding="{Binding OldText}"/>
                                            <GridViewColumn Header="Folder" Width="480" DisplayMemberBinding="{Binding Path}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>

                            <!-- Journal files: pick one or more to recycle -->
                            <DockPanel Grid.Column="2">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <Button x:Name="RecycleSelectedButton" DockPanel.Dock="Right" Content="Move selected to Recycle Bin" Margin="4,0,0,0"
                                            Click="RecycleSelected_Click" IsEnabled="False"
                                            ToolTip="Move the selected journals to the Recycle Bin (Delete key). Journals a running Revit or a tab here has open are kept."/>
                                    <Button DockPanel.Dock="Right" Content="Select old" Click="SelectOld_Click"
                                            ToolTip="Select every listed journal older than the days above"/>
                                    <TextBlock x:Name="FilesInfo" Foreground="{DynamicResource MutedFg}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <ListView x:Name="FileList" SelectionMode="Extended" SelectionChanged="FileList_SelectionChanged"
                                          MouseDoubleClick="FileList_DoubleClick" KeyDown="FileList_KeyDown"
                                          GridViewColumnHeader.Click="List_HeaderClick"
                                          ToolTip="Click, Ctrl+click or Shift+click to select journals. Double-click to open one in a tab. Right-click for more.">
                                    <ListView.ContextMenu>
                                        <ContextMenu x:Name="FileMenu" Opened="FileMenu_Opened">
                                            <MenuItem x:Name="FileMenuOpen" Header="Open in a tab" InputGestureText="Double-click" FontWeight="SemiBold" Click="FileMenuOpen_Click"/>
                                            <MenuItem x:Name="FileMenuEditor" Header="Open in text editor" Click="FileMenuEditor_Click"/>
                                            <MenuItem x:Name="FileMenuFolder" Header="Open containing folder" Click="FileMenuFolder_Click"/>
                                            <MenuItem x:Name="FileMenuCopyPath" Header="Copy path" Click="FileMenuCopyPath_Click"/>
                                            <Separator/>
                                            <MenuItem x:Name="FileMenuRecycle" Header="Move to Recycle Bin" InputGestureText="Delete" Click="RecycleSelected_Click"/>
                                        </ContextMenu>
                                    </ListView.ContextMenu>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Journal" Width="130" DisplayMemberBinding="{Binding Name}"/>
                                            <GridViewColumn Header="Revit" Width="96" DisplayMemberBinding="{Binding Version}"/>
                                            <GridViewColumn Header="Modified" Width="116" DisplayMemberBinding="{Binding ModifiedText}"/>
                                            <GridViewColumn Header="Age" Width="56" DisplayMemberBinding="{Binding AgeText}"/>
                                            <GridViewColumn Header="Size" Width="70" DisplayMemberBinding="{Binding SizeText}"/>
                                            <GridViewColumn Header="In use" Width="130" DisplayMemberBinding="{Binding State}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Output window -->
        <avalonEdit:TextEditor x:Name="Output"
                 IsReadOnly="True"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 Background="{DynamicResource OutputBg}" Foreground="{DynamicResource OutputFg}"
                 BorderThickness="0" Padding="6" WordWrap="False" ShowLineNumbers="False"
                 VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
